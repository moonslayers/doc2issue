# =============================================================================
# Configuración global de doc2issue
# =============================================================================
# Copiar a .env y completar los valores:
#   cp .env-example .env
#
# El agente leerá estos valores automáticamente,
# evitando tener que preguntarlos cada vez.
# =============================================================================

# Dueño del repositorio (usuario u organización de GitHub)
GITHUB_OWNER=mi-org

# Nombre del repositorio (opcional, para comandos que listan projects)
GITHUB_REPO=mi-repo
